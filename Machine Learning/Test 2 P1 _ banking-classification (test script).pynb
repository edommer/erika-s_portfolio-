Subscribe (No)\"\n","    prob = probabilities[i]\n","    print(f\"Client {i+1}: {result} (Probability of Yes: {prob:.4f})\")\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"60RZnppZ89-q","executionInfo":{"status":"ok","timestamp":1762530218687,"user_tz":300,"elapsed":30980,"user":{"displayName":"She Roars","userId":"18361526859656754775"}},"outputId":"9a93b2d2-0fc3-4f82-a333-1e42f5a7785d"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Mounted at /content/drive\n","Model pipeline loaded successfully from Drive.\n","\n","Predictions for new data:\n","Client 1: No Subscribe (No) (Probability of Yes: 0.1165)\n","Client 2: Subscribe (Yes) (Probability of Yes: 0.8092)\n"]}]}]}